index 9482652..8d464e8 100644
--- a/src/graphics/d3d12/render_target_cache.cpp
+++ b/src/graphics/d3d12/render_target_cache.cpp
@@ -1344,7 +1344,8 @@ bool D3D12RenderTargetCache::Resolve(const memory::Memory& memory, D3D12SharedMe
             // The render target itself instead of the EDRAM buffer.
             descriptor_source = descriptors[direct_source_descriptor];
             D3D12_SHADER_RESOURCE_VIEW_DESC source_srv_desc = {};
-            source_srv_desc.Format = DXGI_FORMAT_R8G8B8A8_UINT;
+            // The render target's own format (see resolve_direct_32bpp_1x.xesli).
+            source_srv_desc.Format = DXGI_FORMAT_R8G8B8A8_UNORM;
             source_srv_desc.Shader4ComponentMapping = D3D12_DEFAULT_SHADER_4_COMPONENT_MAPPING;
             if (direct_source_rt->key().msaa_samples != xenos::MsaaSamples::k1X) {
               source_srv_desc.ViewDimension = D3D12_SRV_DIMENSION_TEXTURE2DMS;
@@ -5700,8 +5701,8 @@ D3D12RenderTargetCache::D3D12RenderTarget* D3D12RenderTargetCache::GetDirectReso
     return nullptr;
   }
   DXGI_FORMAT format = render_target->resource()->GetDesc().Format;
-  if (format != DXGI_FORMAT_R8G8B8A8_TYPELESS && format != DXGI_FORMAT_R8G8B8A8_UNORM &&
-      format != DXGI_FORMAT_R8G8B8A8_UINT) {
+  // Read through an R8G8B8A8_UNORM view, which only these can have.
+  if (format != DXGI_FORMAT_R8G8B8A8_TYPELESS && format != DXGI_FORMAT_R8G8B8A8_UNORM) {
     return nullptr;
   }
   return render_target;
