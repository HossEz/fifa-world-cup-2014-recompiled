+namespace {
+// F9 frame capture (for debugging rendering): logs the
+// average of each byte of the 32-bit words every resolve of one frame wrote.
+bool g_capture_frame = false;
+bool g_capture_key_down = false;
+uint32_t g_capture_resolve_index = 0;
+uint32_t g_capture_draw_index = 0;
+uint32_t g_capture_number = 0;
+
+// Writes guest memory (already read back) to captures/<capture>/<name>.bin
+// for offline viewing (tools/capture_to_png.py untiles and converts them).
+void CaptureDump(const uint8_t* data, uint32_t length, const std::string& name) {
+  std::filesystem::path dir =
+      std::filesystem::path("captures") / fmt::format("{:03}", g_capture_number);
+  std::error_code ec;
+  std::filesystem::create_directories(dir, ec);
+  if (FILE* file = rex::filesystem::OpenFile(dir / (name + ".bin"), "wb")) {
+    fwrite(data, 1, length, file);
+    fclose(file);
+  }
+}
