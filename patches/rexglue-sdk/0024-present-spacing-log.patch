+void D3D12Presenter::TrackPresentSpacing() {
+  uint64_t now = chrono::Clock::QueryHostTickCount();
+  uint64_t last = last_present_tick_;
+  last_present_tick_ = now;
+  if (!last) {
+    return;
+  }
+  double ms = double(now - last) * 1000.0 / double(chrono::Clock::QueryHostTickFrequency());
+  // A pause (loading, the window in the background) isn't a hitch.
+  if (ms > 250.0) {
+    return;
+  }
+  present_spacing_ms_[present_spacing_count_++] = float(ms);
+  if (present_spacing_count_ < kSpacingPresents) {
+    return;
+  }
+  present_spacing_count_ = 0;
+  std::array<float, kSpacingPresents> sorted = present_spacing_ms_;
+  std::sort(sorted.begin(), sorted.end());
+  float median = sorted[kSpacingPresents / 2];
+  // Off the median by more than 2 ms: a frame shown early or late, which with
+  // variable refresh the display shows as it is.
+  uint32_t uneven = 0, long_gaps = 0;
+  for (float spacing : present_spacing_ms_) {
+    uneven += std::abs(spacing - median) > 2.0f;
+    long_gaps += spacing > median * 1.5f;
+  }
+  REXLOG_INFO(
+      "present spacing: p1 {:.2f} ms, p50 {:.2f}, p99 {:.2f}, max {:.1f}; off by over 2 ms "
+      "{}, over 1.5x {}",
+      sorted[kSpacingPresents / 100], median, sorted[kSpacingPresents * 99 / 100],
+      sorted[kSpacingPresents - 1], uneven, long_gaps);
+}
