+void D3D12TextureCache::RecordResolve(const ResolveRecord& record) {
+  if (!record.extent_length) {
+    return;
+  }
+  // A newer resolve replaces any older one whose output it overlaps.
+  uint32_t end = record.extent_start + record.extent_length;
+  for (auto it = resolve_records_.begin(); it != resolve_records_.end();) {
+    const ResolveRecord& old = it->second;
+    if (old.extent_start < end && record.extent_start < old.extent_start + old.extent_length) {
+      it = resolve_records_.erase(it);
+    } else {
+      ++it;
+    }
+  }
+  resolve_records_[record.dest_base] = record;
+}
+
+bool D3D12TextureCache::IsResolveToTextureEligible(const ResolveRecord& record) {
+  return record.dest_info.copy_dest_format == xenos::ColorFormat::k_8_8_8_8 &&
+         uint32_t(record.dest_info.copy_dest_number) == 0 && !record.dest_info.copy_dest_exp_bias &&
+         !record.source_is_depth &&
+         record.source_format == uint32_t(xenos::ColorRenderTargetFormat::k_8_8_8_8) &&
+         record.source_msaa == xenos::MsaaSamples::k1X && !record.offset_x && !record.offset_y;
+}
+
+bool D3D12TextureCache::IsResolveToTextureTarget(const TextureKey& key) const {
+  // Independent of resolve_to_texture being on, so it can be switched while
+  // the game runs.
+  if (!resolve_to_texture_pipeline_ ||
+      key.format != xenos::TextureFormat::k_8_8_8_8 ||
+      key.dimension != xenos::DataDimension::k2DOrStacked || key.GetDepthOrArraySize() != 1 ||
+      key.mip_max_level || !key.tiled || key.signed_separate) {
+    return false;
+  }
+  auto it = resolve_records_.find(key.base_page << 12);
+  return it != resolve_records_.end() && IsResolveToTextureEligible(it->second);
+}
+
+bool D3D12TextureCache::DoesTextureMatchResolve(const TextureKey& key,
+                                                const ResolveRecord& record) const {
+  return IsResolveToTextureEligible(record) && bool(key.scaled_resolve) == IsDrawResolutionScaled() &&
+         key.GetWidth() <= record.width && key.GetHeight() <= record.height &&
+         key.pitch * 32 == record.pitch_aligned &&
+         uint32_t(key.endianness) == uint32_t(record.dest_info.copy_dest_endian);
+}
+
+void D3D12TextureCache::LearnResolveTextureKey(const D3D12Texture& texture) {
+  const TextureKey& key = texture.key();
+  if (!REXCVAR_GET(resolve_to_texture) || !IsResolveToTextureTarget(key) ||
+      !(texture.resource()->GetDesc().Flags & D3D12_RESOURCE_FLAG_ALLOW_UNORDERED_ACCESS)) {
+    return;
+  }
+  uint32_t base = key.base_page << 12;
+  auto record_it = resolve_records_.find(base);
+  if (record_it == resolve_records_.end() || !DoesTextureMatchResolve(key, record_it->second)) {
+    return;
+  }
+  resolve_texture_keys_[base] = key;
+}
+
+void D3D12TextureCache::WriteResolveToTexture(const ResolveRecord& record, ID3D12Resource* source,
+                                              uint32_t width_scaled, uint32_t height_scaled) {
+  if (!REXCVAR_GET(resolve_to_texture) || !resolve_to_texture_pipeline_) {
+    return;
+  }
+  auto key_it = resolve_texture_keys_.find(record.dest_base);
+  if (key_it == resolve_texture_keys_.end()) {
+    return;
+  }
+  TextureKey key = key_it->second;
+  if (!DoesTextureMatchResolve(key, record)) {
+    // The game resolves something else here now.
+    resolve_texture_keys_.erase(key_it);
+    return;
+  }
+  uint32_t texture_width_scaled = key.GetWidth();
+  uint32_t texture_height_scaled = key.GetHeight();
+  if (key.scaled_resolve) {
+    texture_width_scaled *= draw_resolution_scale_x();
+    texture_height_scaled *= draw_resolution_scale_y();
+  }
+  if (texture_width_scaled > width_scaled || texture_height_scaled > height_scaled) {
+    return;
+  }
+  auto* texture = static_cast<D3D12Texture*>(FindOrCreateTexture(key));
+  if (!texture ||
+      !(texture->resource()->GetDesc().Flags & D3D12_RESOURCE_FLAG_ALLOW_UNORDERED_ACCESS)) {
+    resolve_texture_keys_.erase(record.dest_base);
+    return;
+  }
+  ui::d3d12::util::DescriptorCpuGpuHandlePair descriptors[2];
+  if (!command_processor_.RequestOneUseSingleViewDescriptors(2, descriptors)) {
+    return;
+  }
+  ID3D12Device* device = command_processor_.GetD3D12Provider().GetDevice();
+  D3D12_SHADER_RESOURCE_VIEW_DESC srv_desc = {};
+  srv_desc.Format = DXGI_FORMAT_R8G8B8A8_UNORM;
+  srv_desc.ViewDimension = D3D12_SRV_DIMENSION_TEXTURE2D;
+  srv_desc.Shader4ComponentMapping = D3D12_DEFAULT_SHADER_4_COMPONENT_MAPPING;
+  srv_desc.Texture2D.MipLevels = 1;
+  device->CreateShaderResourceView(source, &srv_desc, descriptors[0].first);
+  D3D12_UNORDERED_ACCESS_VIEW_DESC uav_desc = {};
+  uav_desc.Format = DXGI_FORMAT_R8G8B8A8_UNORM;
+  uav_desc.ViewDimension = D3D12_UAV_DIMENSION_TEXTURE2D;
+  device->CreateUnorderedAccessView(texture->resource(), nullptr, &uav_desc,
+                                    descriptors[1].first);
+  command_processor_.PushTransitionBarrier(
+      texture->resource(), texture->SetResourceState(D3D12_RESOURCE_STATE_UNORDERED_ACCESS),
+      D3D12_RESOURCE_STATE_UNORDERED_ACCESS);
+  command_processor_.SubmitBarriers();
+  DeferredCommandList& command_list = command_processor_.GetDeferredCommandList();
+  command_list.D3DSetComputeRootSignature(resolve_to_texture_root_signature_.Get());
+  uint32_t constants[3] = {texture_width_scaled, texture_height_scaled,
+                           uint32_t(record.dest_info.copy_dest_swap)};
+  command_list.D3DSetComputeRoot32BitConstants(0, 3, constants, 0);
+  command_list.D3DSetComputeRootDescriptorTable(1, descriptors[0].second);
+  command_list.D3DSetComputeRootDescriptorTable(2, descriptors[1].second);
+  command_processor_.SetExternalPipeline(resolve_to_texture_pipeline_.Get());
+  command_list.D3DDispatch((texture_width_scaled + 7) / 8, (texture_height_scaled + 7) / 8, 1);
+  // The resolve's invalidation of the texture (MarkRangeAsResolved) has
+  // already happened: it holds the resolve's output now, no load needed.
+  texture->MakeUpToDateAndWatch(rex::thread::global_critical_region::AcquireDirect());
+  texture->MarkAsUsed();
+}
+
 }  // namespace rex::graphics::d3d12
