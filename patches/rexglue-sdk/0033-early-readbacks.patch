+void CommandProcessor::ExecuteQueuedGpuMemoryReadbacks() {
+  if (!gpu_copies_pending_.load(std::memory_order_acquire)) {
+    return;
+  }
+  std::vector<QueuedGpuMemoryCopy> readbacks;
+  {
+    std::lock_guard lock(gpu_copy_mutex_);
+    size_t count = 0;
+    while (count < gpu_copies_.size() && gpu_copies_[count].src == UINT32_MAX) {
+      ++count;
+    }
+    if (!count) {
+      return;
+    }
+    readbacks.assign(gpu_copies_.begin(), gpu_copies_.begin() + count);
+    gpu_copies_.erase(gpu_copies_.begin(), gpu_copies_.begin() + count);
+    gpu_copies_pending_.store(!gpu_copies_.empty(), std::memory_order_relaxed);
+  }
+  for (const QueuedGpuMemoryCopy& readback : readbacks) {
+    ExecuteGpuMemoryReadback(readback.dst, readback.length);
+    MarkGpuMemoryNewer(readback.dst, readback.length, false);
+    readback.done->store(true, std::memory_order_release);
+  }
+  std::lock_guard lock(gpu_copy_mutex_);
+  gpu_copy_done_cv_.notify_all();
+}
