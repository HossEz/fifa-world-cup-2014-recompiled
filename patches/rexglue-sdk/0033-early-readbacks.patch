+bool D3D12CommandProcessor::ReadbackFromPrefetch(uint32_t address, uint32_t length) {
+  if (!REXCVAR_GET(readback_prefetch)) {
+    return false;
+  }
+  auto find = [&]() {
+    return std::find_if(readback_prefetches_.begin(), readback_prefetches_.end(),
+                        [&](const ReadbackPrefetch& prefetch) {
+                          return prefetch.valid && prefetch.address <= address &&
+                                 uint64_t(address) + length <=
+                                     uint64_t(prefetch.address) + prefetch.length;
+                        });
+  };
+  uint64_t submission;
+  ID3D12Resource* buffer;
+  uint32_t offset;
+  {
+    std::lock_guard lock(readback_prefetch_mutex_);
+    auto it = find();
+    if (it == readback_prefetches_.end()) {
+      return false;
+    }
+    submission = it->submission;
+    buffer = it->buffer.Get();
+    offset = address - it->address;
+  }
+  CheckSubmissionFence(submission);
+  {
+    // Nothing may have written the range while waiting.
+    std::lock_guard lock(readback_prefetch_mutex_);
+    auto it = find();
+    if (it == readback_prefetches_.end() || it->buffer.Get() != buffer ||
+        it->submission != submission) {
+      return false;
+    }
+  }
+  D3D12_RANGE read_range = {offset, SIZE_T(offset) + length};
+  void* mapping;
+  if (FAILED(buffer->Map(0, &read_range, &mapping))) {
+    return false;
+  }
+  // Through the physical membase, as in ExecuteGpuMemoryReadback.
+  std::memcpy(memory_->TranslatePhysical(address), static_cast<uint8_t*>(mapping) + offset,
+              length);
+  D3D12_RANGE written_range = {};
+  buffer->Unmap(0, &written_range);
+  return true;
 }
 
