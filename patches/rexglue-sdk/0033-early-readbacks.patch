+void D3D12CommandProcessor::PrefetchResolveForReadback(uint32_t address, uint32_t length) {
+  // The resolve replaces what an earlier one left in the range.
+  InvalidateReadbackPrefetches(address, length);
+  if (!REXCVAR_GET(readback_prefetch)) {
+    return;
+  }
+  {
+    std::lock_guard lock(readback_prefetch_mutex_);
+    if (std::none_of(readback_targets_.begin(), readback_targets_.end(), [&](const auto& target) {
+          return target.first < uint64_t(address) + length &&
+                 address < uint64_t(target.first) + target.second;
+        })) {
+      return;
+    }
+  }
+  // The data as the guest will see it: downscaled if the resolve was scaled.
+  FlushPendingDownscales(address, length);
+  if (!BeginSubmission(true) || !shared_memory_->RequestRange(address, length)) {
+    return;
+  }
+  uint32_t buffer_size = rex::align(length, uint32_t(1) << 16);
+  ID3D12Resource* buffer;
+  {
+    std::unique_lock lock(readback_prefetch_mutex_);
+    auto it = std::find_if(
+        readback_prefetches_.begin(), readback_prefetches_.end(),
+        [&](const ReadbackPrefetch& prefetch) { return prefetch.address == address; });
+    if (it == readback_prefetches_.end()) {
+      if (readback_prefetches_.size() < kMaxReadbackPrefetches) {
+        readback_prefetches_.push_back({address, 0, 0, nullptr, 0, false});
+        it = std::prev(readback_prefetches_.end());
+      } else {
+        // Reuse the oldest one's buffer: if the GPU is still writing it, the
+        // queue orders that before this copy.
+        it = std::min_element(readback_prefetches_.begin(), readback_prefetches_.end(),
+                              [](const ReadbackPrefetch& a, const ReadbackPrefetch& b) {
+                                return a.submission < b.submission;
+                              });
+        it->address = address;
+      }
+    }
+    it->valid = false;
+    if (it->buffer_size < buffer_size) {
+      // The old buffer may be in use by a submitted copy.
+      uint64_t old_submission = it->submission;
+      size_t index = size_t(it - readback_prefetches_.begin());
+      lock.unlock();
+      if (old_submission) {
+        CheckSubmissionFence(old_submission);
+        if (!BeginSubmission(true)) {
+          return;
+        }
+      }
+      D3D12_RESOURCE_DESC buffer_desc;
+      ui::d3d12::util::FillBufferResourceDesc(buffer_desc, buffer_size, D3D12_RESOURCE_FLAG_NONE);
+      Microsoft::WRL::ComPtr<ID3D12Resource> new_buffer;
+      const ui::d3d12::D3D12Provider& provider = GetD3D12Provider();
+      if (FAILED(provider.GetDevice()->CreateCommittedResource(
+              &ui::d3d12::util::kHeapPropertiesReadback, provider.GetHeapFlagCreateNotZeroed(),
+              &buffer_desc, D3D12_RESOURCE_STATE_COPY_DEST, nullptr, IID_PPV_ARGS(&new_buffer)))) {
+        return;
+      }
+      lock.lock();
+      it = readback_prefetches_.begin() + index;
+      it->buffer = std::move(new_buffer);
+      it->buffer_size = buffer_size;
+    }
+    buffer = it->buffer.Get();
+  }
+  shared_memory_->UseAsCopySource();
+  SubmitBarriers();
+  deferred_command_list_.D3DCopyBufferRegion(buffer, 0, shared_memory_->GetBuffer(), address,
+                                             length);
+  {
+    std::lock_guard lock(readback_prefetch_mutex_);
+    for (ReadbackPrefetch& prefetch : readback_prefetches_) {
+      if (prefetch.buffer.Get() == buffer) {
+        prefetch.length = length;
+        prefetch.submission = submission_current_;
+        prefetch.valid = true;
+      }
+    }
+  }
+  // Start the GPU on it now instead of at the end of the frame.
+  EndSubmission(false);
+}
+
+void D3D12CommandProcessor::InvalidateReadbackPrefetches(uint32_t address, uint32_t length) {
+  std::lock_guard lock(readback_prefetch_mutex_);
+  for (ReadbackPrefetch& prefetch : readback_prefetches_) {
+    if (prefetch.address < uint64_t(address) + length &&
+        address < uint64_t(prefetch.address) + prefetch.length) {
+      prefetch.valid = false;
+    }
+  }
+}
