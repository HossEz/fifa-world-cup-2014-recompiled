+void D3D12CommandProcessor::FlushPendingDownscales(uint32_t start, uint32_t length) {
+  uint64_t end = uint64_t(start) + length;
+  for (;;) {
+    PendingDownscale flush[16];
+    uint32_t flush_count = 0;
+    {
+      std::lock_guard<std::mutex> lock(pending_downscales_mutex_);
+      for (auto it = pending_downscales_.begin();
+           it != pending_downscales_.end() && flush_count < uint32_t(rex::countof(flush));) {
+        if (it->address < end && start < uint64_t(it->address) + it->length) {
+          flush[flush_count++] = *it;
+          it = pending_downscales_.erase(it);
+        } else {
+          ++it;
+        }
+      }
+    }
+    if (!flush_count || !BeginSubmission(true)) {
+      return;
+    }
+    // A draw may have bound its pipeline already (index buffers are requested
+    // after that): rebind it after the downscale's compute pipeline.
+    void* guest_pipeline = current_guest_pipeline_;
+    for (uint32_t i = 0; i < flush_count; ++i) {
+      DownscaleResolveToSharedMemory(flush[i].address, flush[i].length, flush[i].pixel_size_log2);
+    }
+    if (guest_pipeline && current_guest_pipeline_ != guest_pipeline) {
+      deferred_command_list_.SetPipelineStateHandle(guest_pipeline);
+      current_guest_pipeline_ = guest_pipeline;
+      current_external_pipeline_ = nullptr;
+    }
+  }
 }
 
