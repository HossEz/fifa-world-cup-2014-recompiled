+bool D3D12TextureCache::AllocateTextureMemory(uint64_t size, uint64_t alignment,
+                                              TextureHeapAllocation& out) {
+  alignment = std::max(alignment, uint64_t(D3D12_DEFAULT_RESOURCE_PLACEMENT_ALIGNMENT));
+  auto try_heap = [&](uint32_t heap) {
+    std::map<uint64_t, uint64_t>& free_blocks = texture_heap_free_[heap];
+    for (auto it = free_blocks.begin(); it != free_blocks.end(); ++it) {
+      uint64_t block_start = it->first;
+      uint64_t block_end = block_start + it->second;
+      uint64_t start = (block_start + alignment - 1) & ~(alignment - 1);
+      if (start + size > block_end) {
+        continue;
+      }
+      free_blocks.erase(it);
+      if (start > block_start) {
+        free_blocks.emplace(block_start, start - block_start);
+      }
+      if (start + size < block_end) {
+        free_blocks.emplace(start + size, block_end - (start + size));
+      }
+      out.heap = heap;
+      out.offset = start;
+      out.size = size;
+      return true;
+    }
+    return false;
+  };
+  for (uint32_t i = 0; i < uint32_t(texture_heaps_.size()); ++i) {
+    if (texture_heaps_[i] && try_heap(i)) {
+      return true;
+    }
+  }
+  // A new heap, in a released slot if there is one.
+  const ui::d3d12::D3D12Provider& provider = command_processor_.GetD3D12Provider();
+  D3D12_HEAP_DESC heap_desc = {};
+  heap_desc.SizeInBytes = kTextureHeapSize;
+  heap_desc.Properties = ui::d3d12::util::kHeapPropertiesDefault;
+  heap_desc.Alignment = D3D12_DEFAULT_RESOURCE_PLACEMENT_ALIGNMENT;
+  heap_desc.Flags =
+      D3D12_HEAP_FLAG_ALLOW_ONLY_NON_RT_DS_TEXTURES | provider.GetHeapFlagCreateNotZeroed();
+  Microsoft::WRL::ComPtr<ID3D12Heap> heap;
+  if (FAILED(provider.GetDevice()->CreateHeap(&heap_desc, IID_PPV_ARGS(&heap)))) {
+    return false;
+  }
+  uint32_t index = 0;
+  while (index < uint32_t(texture_heaps_.size()) && texture_heaps_[index]) {
+    ++index;
+  }
+  if (index == uint32_t(texture_heaps_.size())) {
+    texture_heaps_.emplace_back();
+    texture_heap_free_.emplace_back();
+  }
+  texture_heaps_[index] = std::move(heap);
+  texture_heap_free_[index].clear();
+  texture_heap_free_[index].emplace(0, kTextureHeapSize);
+  return try_heap(index);
+}
+
+void D3D12TextureCache::FreeTextureMemory(const TextureHeapAllocation& allocation) {
+  if (allocation.heap >= uint32_t(texture_heaps_.size()) || !allocation.size) {
+    return;
+  }
+  std::map<uint64_t, uint64_t>& free_blocks = texture_heap_free_[allocation.heap];
+  uint64_t start = allocation.offset;
+  uint64_t end = start + allocation.size;
+  // Merge with the free neighbours.
+  auto next = free_blocks.lower_bound(start);
+  if (next != free_blocks.end() && next->first == end) {
+    end += next->second;
+    next = free_blocks.erase(next);
+  }
+  if (next != free_blocks.begin()) {
+    auto previous = std::prev(next);
+    if (previous->first + previous->second == start) {
+      start = previous->first;
+      free_blocks.erase(previous);
+    }
+  }
+  free_blocks.emplace(start, end - start);
+  // Keep one empty heap for the next textures, release the others.
+  if (start == 0 && end == kTextureHeapSize) {
+    uint32_t empty_heaps = 0;
+    for (uint32_t i = 0; i < uint32_t(texture_heaps_.size()); ++i) {
+      empty_heaps += texture_heaps_[i] && texture_heap_free_[i].size() == 1 &&
+                     texture_heap_free_[i].begin()->second == kTextureHeapSize;
+    }
+    if (empty_heaps > 1) {
+      texture_heaps_[allocation.heap].Reset();
+      free_blocks.clear();
+    }
+  }
+}
