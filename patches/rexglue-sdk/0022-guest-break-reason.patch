+void BreakWithReason(const std::string& reason) {
+  auto* thread = XThread::GetCurrentThread();
+  REXKRNL_ERROR("Guest stopped: {} (thread {:08X})", reason, thread ? thread->thread_id() : 0);
+  rex::FlushLogging();
   rex::debug::Break();
 }
 
+void DbgBreakPoint_entry() {
+  BreakWithReason("DbgBreakPoint");
+}
