+bool D3D12Presenter::TrackPresentTime(uint64_t present_ticks, bool gpu_behind) {
+  // A present that doesn't wait for the display takes well under a
+  // millisecond. Most presents with the GPU not behind waiting longer, over a
+  // block of presents, means they wait for the display. Normally a few percent
+  // do; stuck on the waiting path, almost all of them (and then the GPU is
+  // mostly reported behind too, as the frames queue up, so few are counted).
+  constexpr double kSlowMs = 2.0;
+  constexpr uint32_t kBlockPresents = 300;
+  constexpr uint32_t kMinCountedToRecreate = 10;
+  constexpr uint64_t kLogSeconds = 10;
+  // A stall again within this time of a recreation: that one didn't help, so
+  // it's most likely the GPU being too slow (a heavy scene), which a new swap
+  // chain can't fix, and no recreation is tried for kRecreateBackoffSeconds.
+  constexpr uint64_t kRecreateRetrySeconds = 10;
+  constexpr uint64_t kRecreateBackoffSeconds = 60;
+
+  PresentStats& stats = present_stats_;
+  uint64_t frequency = chrono::Clock::QueryHostTickFrequency();
+  double ms = double(present_ticks) * 1000.0 / double(frequency);
+  ++stats.count;
+  if (!gpu_behind) {
+    ++stats.counted;
+    stats.slow += ms > kSlowMs;
+  }
+  stats.sum_ms += ms;
+  stats.max_ms = std::max(stats.max_ms, ms);
+  if (stats.count < kBlockPresents) {
+    return false;
+  }
+
+  uint64_t now = chrono::Clock::QueryHostTickCount();
+  bool stalled = stats.counted >= kMinCountedToRecreate && stats.slow * 5 >= stats.counted * 4;
+  if (stalled || now - stats.last_log_tick >= kLogSeconds * frequency) {
+    REXLOG_INFO(
+        "D3D12Presenter: presents in the last {}: mean {:.2f} ms, max {:.1f}; with the GPU not "
+        "behind {}, of them over {:.0f} ms {}",
+        stats.count, stats.sum_ms / stats.count, stats.max_ms, stats.counted, kSlowMs,
+        stats.slow);
+    stats.last_log_tick = now;
+  }
+  stats.count = 0;
+  stats.counted = 0;
+  stats.slow = 0;
+  stats.sum_ms = 0.0;
+  stats.max_ms = 0.0;
+
+  if (!stalled || !REXCVAR_GET(d3d12_present_stall_recovery) ||
+      now < stats.no_recreate_before_tick) {
+    return false;
+  }
+  if (stats.last_recreate_tick &&
+      now - stats.last_recreate_tick < kRecreateRetrySeconds * frequency) {
+    stats.no_recreate_before_tick = now + kRecreateBackoffSeconds * frequency;
+    REXLOG_WARN(
+        "D3D12Presenter: presents still slow after a new swap chain (the GPU is likely too slow "
+        "here), not recreating it for {} s",
+        kRecreateBackoffSeconds);
+    return false;
   }
+  stats.last_recreate_tick = now;
+  REXLOG_WARN("D3D12Presenter: presents wait for the display, recreating the swap chain");
+  return true;
 }
 
