+void D3D12CommandProcessor::RecordDrawForHangReport(uint64_t vertex_shader,
+                                                    uint64_t pixel_shader) {
+  if (hang_report_.empty() || hang_report_.back().submission != submission_current_) {
+    // Nothing completes once the device is lost: keep the oldest, the one that hung.
+    if (hang_report_.size() >= kHangReportMaxSubmissions) {
+      return;
+    }
+    hang_report_.emplace_back().submission = submission_current_;
+  }
+  HangReportSubmission& submission = hang_report_.back();
+  ++submission.draws;
+  if (submission.draws > 1 && submission.last_vertex_shader == vertex_shader &&
+      submission.last_pixel_shader == pixel_shader) {
+    return;
+  }
+  submission.last_vertex_shader = vertex_shader;
+  submission.last_pixel_shader = pixel_shader;
+  if (hang_report_seen_shaders_.insert(vertex_shader ^ (pixel_shader * 0x9E3779B97F4A7C15ull))
+          .second &&
+      submission.new_shaders.size() < kHangReportMaxNewShaders) {
+    submission.new_shaders.emplace_back(vertex_shader, pixel_shader);
+  }
+}
+
+void D3D12CommandProcessor::LogHangReport() {
+  if (hang_report_.empty()) {
+    REXGPU_ERROR("GPU work not finished at the reset: none recorded (no draws)");
+    return;
+  }
+  REXGPU_ERROR("GPU work not finished at the reset: {} submissions, the first one most likely hung",
+               hang_report_.size());
+  size_t logged = 0;
+  for (const HangReportSubmission& submission : hang_report_) {
+    if (++logged > 3) {
+      break;
+    }
+    std::string shaders;
+    for (const auto& [vertex_shader, pixel_shader] : submission.new_shaders) {
+      shaders += fmt::format(" vs {:016X} ps {:016X},", vertex_shader, pixel_shader);
+    }
+    if (!shaders.empty()) {
+      shaders.pop_back();
+    }
+    REXGPU_ERROR("  submission {}: {} draws, last vs {:016X} ps {:016X}; first drawn here:{}",
+                 submission.submission, submission.draws, submission.last_vertex_shader,
+                 submission.last_pixel_shader, shaders.empty() ? " none" : shaders);
+  }
+}
