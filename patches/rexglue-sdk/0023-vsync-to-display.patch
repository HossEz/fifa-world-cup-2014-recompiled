 namespace rex::ui::d3d12 {
 
+void D3D12Presenter::UpdateDisplay() {
+  Microsoft::WRL::ComPtr<IDXGIOutput> output;
+  uint32_t refresh_hz = 0;
+  if (paint_context_.swap_chain &&
+      SUCCEEDED(paint_context_.swap_chain->GetContainingOutput(&output))) {
+    DXGI_OUTPUT_DESC desc;
+    DEVMODEW mode = {};
+    mode.dmSize = sizeof(mode);
+    if (SUCCEEDED(output->GetDesc(&desc)) &&
+        EnumDisplaySettingsW(desc.DeviceName, ENUM_CURRENT_SETTINGS, &mode)) {
+      refresh_hz = mode.dmDisplayFrequency;
+    }
+  }
+  std::lock_guard<std::mutex> lock(display_mutex_);
+  if (refresh_hz != display_refresh_hz_) {
+    REXLOG_INFO("D3D12Presenter: display at {} Hz", refresh_hz);
+  }
+  display_output_ = refresh_hz ? output : nullptr;
+  display_refresh_hz_ = refresh_hz;
+}
+
+bool D3D12Presenter::WaitForDisplayVblank(double guest_refresh_hz) {
+  Microsoft::WRL::ComPtr<IDXGIOutput> output;
+  {
+    std::lock_guard<std::mutex> lock(display_mutex_);
+    // 59 or 61 for a 59.94 or 60.0x Hz mode. At 120 Hz or more the display
+    // can't be followed one to one; there, as with variable refresh, the
+    // guest keeps its timer and frames go out as soon as they're ready.
+    if (REXCVAR_GET(vsync_to_display) && display_output_ &&
+        std::abs(double(display_refresh_hz_) - guest_refresh_hz) <= 1.5) {
+      output = display_output_;
+    }
+  }
+  bool locked = output && SUCCEEDED(output->WaitForVBlank());
+  if (locked != display_locked_.exchange(locked, std::memory_order_relaxed)) {
+    REXLOG_INFO("D3D12Presenter: guest vblanks {} the display", locked ? "follow" : "no longer follow");
+  }
+  return locked;
+}
