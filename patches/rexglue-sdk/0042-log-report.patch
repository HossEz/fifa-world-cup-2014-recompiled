+bool D3D12CommandProcessor::EnsureGpuLoadResources() {
+  if (gpu_load_mapping_) {
+    return true;
+  }
+  if (gpu_load_failed_) {
+    return false;
+  }
+  gpu_load_failed_ = true;
+  const ui::d3d12::D3D12Provider& provider = GetD3D12Provider();
+  ID3D12Device* device = provider.GetDevice();
+  if (FAILED(provider.GetDirectQueue()->GetTimestampFrequency(&gpu_load_frequency_)) ||
+      !gpu_load_frequency_) {
+    return false;
+  }
+  D3D12_QUERY_HEAP_DESC heap_desc = {};
+  heap_desc.Type = D3D12_QUERY_HEAP_TYPE_TIMESTAMP;
+  heap_desc.Count = kGpuLoadSlots * 2;
+  if (FAILED(device->CreateQueryHeap(&heap_desc, IID_PPV_ARGS(&gpu_load_query_heap_)))) {
+    return false;
+  }
+  D3D12_RESOURCE_DESC buffer_desc;
+  ui::d3d12::util::FillBufferResourceDesc(buffer_desc, sizeof(uint64_t) * kGpuLoadSlots * 2,
+                                          D3D12_RESOURCE_FLAG_NONE);
+  if (FAILED(device->CreateCommittedResource(
+          &ui::d3d12::util::kHeapPropertiesReadback, provider.GetHeapFlagCreateNotZeroed(),
+          &buffer_desc, D3D12_RESOURCE_STATE_COPY_DEST, nullptr,
+          IID_PPV_ARGS(&gpu_load_readback_)))) {
+    return false;
+  }
+  D3D12_RANGE read_range = {0, sizeof(uint64_t) * kGpuLoadSlots * 2};
+  void* mapping = nullptr;
+  if (FAILED(gpu_load_readback_->Map(0, &read_range, &mapping))) {
+    return false;
+  }
+  Microsoft::WRL::ComPtr<IDXGIFactory4> factory;
+  if (SUCCEEDED(provider.GetDXGIFactory()->QueryInterface(IID_PPV_ARGS(&factory)))) {
+    factory->EnumAdapterByLuid(device->GetAdapterLuid(), IID_PPV_ARGS(&gpu_load_adapter_));
+  }
+  gpu_load_mapping_ = static_cast<const uint64_t*>(mapping);
+  gpu_load_failed_ = false;
+  return true;
+}
+
+void D3D12CommandProcessor::UpdateGpuLoadLog() {
+  if (!gpu_load_mapping_ || gpu_load_read_submission_ == UINT64_MAX) {
+    return;
+  }
+  ++gpu_load_frames_;
+  // Slots overwritten since the last read are skipped.
+  if (submission_completed_ + 1 > gpu_load_read_submission_ + kGpuLoadSlots) {
+    gpu_load_read_submission_ = submission_completed_ + 1 - kGpuLoadSlots;
+  }
+  for (; gpu_load_read_submission_ <= submission_completed_; ++gpu_load_read_submission_) {
+    uint32_t slot = uint32_t(gpu_load_read_submission_ % kGpuLoadSlots) * 2;
+    uint64_t begin = gpu_load_mapping_[slot];
+    uint64_t end = gpu_load_mapping_[slot + 1];
+    if (end > begin) {
+      gpu_load_busy_ticks_ += end - begin;
+    }
+  }
+  uint64_t now = chrono::Clock::QueryHostTickCount();
+  uint64_t frequency = chrono::Clock::QueryHostTickFrequency();
+  if (!gpu_load_last_log_) {
+    gpu_load_last_log_ = now;
+    gpu_load_frames_ = 0;
+    gpu_load_busy_ticks_ = 0;
+    return;
+  }
+  if (now - gpu_load_last_log_ < frequency * 10) {
+    return;
+  }
+  double seconds = double(now - gpu_load_last_log_) / double(frequency);
+  double busy_seconds = double(gpu_load_busy_ticks_) / double(gpu_load_frequency_);
+  std::string memory;
+  DXGI_QUERY_VIDEO_MEMORY_INFO memory_info;
+  if (gpu_load_adapter_ && SUCCEEDED(gpu_load_adapter_->QueryVideoMemoryInfo(
+                               0, DXGI_MEMORY_SEGMENT_GROUP_LOCAL, &memory_info))) {
+    memory = fmt::format("; video memory {} of {} MB", memory_info.CurrentUsage >> 20,
+                         memory_info.Budget >> 20);
+  }
+  REXGPU_INFO("gpu load: busy {:.0f}% of the time, {:.1f} ms per frame, {} frames in {:.1f} s{}",
+              busy_seconds * 100.0 / seconds, busy_seconds * 1000.0 / std::max(gpu_load_frames_, 1u),
+              gpu_load_frames_, seconds, memory);
+  gpu_load_last_log_ = now;
+  gpu_load_frames_ = 0;
+  gpu_load_busy_ticks_ = 0;
 }
 
