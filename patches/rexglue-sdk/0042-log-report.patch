+// Players post their logs in public. A path's user folder never reaches the file,
+// whichever code logged the path: C:\Users\Name\... becomes C:\Users\<user>\...
+std::string HideUserFolders(std::string_view text) {
+  std::string result;
+  size_t copied = 0;
+  for (size_t i = 0; i + 7 <= text.size(); ++i) {
+    char separator = text[i];
+    if ((separator != '\\' && separator != '/') || text[i + 6] != separator) {
+      continue;
+    }
+    static const char kUsers[] = "users";
+    bool match = true;
+    for (size_t j = 0; j < 5 && match; ++j) {
+      match = (text[i + 1 + j] | 0x20) == kUsers[j];
+    }
+    if (!match) {
+      continue;
+    }
+    size_t name = i + 7;
+    size_t end = name;
+    while (end < text.size() && text[end] != '\\' && text[end] != '/' && text[end] != '\'' &&
+           text[end] != '"') {
+      ++end;
+    }
+    result.append(text.substr(copied, name - copied));
+    result += "<user>";
+    copied = end;
+    i = end > 0 ? end - 1 : 0;
+  }
+  if (copied == 0) {
+    return std::string(text);
+  }
+  result.append(text.substr(copied));
+  return result;
+}
+
+class PrivateFileSink final : public spdlog::sinks::sink {
+ public:
+  explicit PrivateFileSink(spdlog::sink_ptr file) : file_(std::move(file)) {}
+  void log(const spdlog::details::log_msg& msg) override {
+    std::string text = HideUserFolders(std::string_view(msg.payload.data(), msg.payload.size()));
+    spdlog::details::log_msg clean = msg;
+    clean.payload = spdlog::string_view_t(text.data(), text.size());
+    file_->log(clean);
+  }
+  void flush() override { file_->flush(); }
+  void set_pattern(const std::string& pattern) override { file_->set_pattern(pattern); }
+  void set_formatter(std::unique_ptr<spdlog::formatter> formatter) override {
+    file_->set_formatter(std::move(formatter));
+  }
+
+ private:
+  spdlog::sink_ptr file_;
+};
