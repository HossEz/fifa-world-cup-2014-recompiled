+#ifndef CREATE_WAITABLE_TIMER_HIGH_RESOLUTION
+#define CREATE_WAITABLE_TIMER_HIGH_RESOLUTION 0x00000002
+#endif
+
 #include <spdlog/spdlog.h>
 
 #include <rex/assert.h>
@@ -93,16 +99,52 @@ void SyncMemory() {
   MemoryBarrier();
 }
 
+namespace {
+
+// ::Sleep takes whole milliseconds, and 0 only yields: a 250 us poll became a
+// thread spinning a core at 100%, heating laptops at a fraction of the CPU's
+// total use. A high-resolution waitable timer (Windows 10 1803 and later)
+// sleeps for the time asked; one per thread, closed when the thread ends.
+struct HighResolutionTimer {
+  HANDLE handle = CreateWaitableTimerExW(nullptr, nullptr,
+                                         CREATE_WAITABLE_TIMER_HIGH_RESOLUTION,
+                                         TIMER_ALL_ACCESS);
+  ~HighResolutionTimer() {
+    if (handle) {
+      CloseHandle(handle);
+    }
+  }
+};
+
+// Sleeps `duration` (at least 100 us). Returns the wait's result
+// (WAIT_IO_COMPLETION if alertable and an APC came).
+DWORD SleepFor(std::chrono::microseconds duration, bool alertable) {
+  thread_local HighResolutionTimer timer;
+  if (timer.handle && duration < std::chrono::milliseconds(20)) {
+    LARGE_INTEGER due;
+    due.QuadPart = -int64_t(duration.count()) * 10;  // relative, 100 ns units
+    if (SetWaitableTimerEx(timer.handle, &due, 0, nullptr, nullptr, nullptr, 0)) {
+      return WaitForSingleObjectEx(timer.handle, INFINITE, alertable ? TRUE : FALSE);
+    }
+  }
+  // Rounded up: asking for 0 ms would only yield.
+  DWORD ms = DWORD(std::max<int64_t>(1, (duration.count() + 999) / 1000));
+  return SleepEx(ms, alertable ? TRUE : FALSE);
+}
+
+}  // namespace
+
 void Sleep(std::chrono::microseconds duration) {
   if (duration.count() < 100) {
     MaybeYield();
   } else {
-    ::Sleep(static_cast<DWORD>(duration.count() / 1000));
+    SleepFor(duration, false);
   }
 }
 
 SleepResult AlertableSleep(std::chrono::microseconds duration) {
-  if (SleepEx(static_cast<DWORD>(duration.count() / 1000), TRUE) == WAIT_IO_COMPLETION) {
+  DWORD result = duration.count() < 100 ? SleepEx(0, TRUE) : SleepFor(duration, true);
+  if (result == WAIT_IO_COMPLETION) {
     return SleepResult::kAlerted;
   }
   return SleepResult::kSuccess;
