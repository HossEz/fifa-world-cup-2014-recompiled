--- a/include/rex/ui/imgui_dialog.h
+++ b/include/rex/ui/imgui_dialog.h
@@ -39,6 +39,13 @@ class ImGuiDialog {
 
   void Draw();
 
+  // Whether the window has to be repainted continuously while the dialog is
+  // up (it animates or takes input on its own). An overlay drawn with each
+  // guest frame doesn't: repainting at the display's full rate besides the
+  // guest's frames makes the frames reach the display unevenly, and keeps
+  // variable refresh at its maximum rate.
+  virtual bool WantsContinuousPaint() const { return true; }
+
  protected:
   ImGuiDialog(ImGuiDrawer* imgui_drawer);
 
