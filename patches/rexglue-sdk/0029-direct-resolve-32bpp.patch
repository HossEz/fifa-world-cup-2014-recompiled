+D3D12RenderTargetCache::D3D12RenderTarget* D3D12RenderTargetCache::GetDirectResolve32bppSource(
+    const draw_util::ResolveInfo& resolve_info, draw_util::ResolveCopyShaderIndex copy_shader) {
+  const draw_util::ResolveEdramInfo& edram_info = resolve_info.color_edram_info;
+  if (!REXCVAR_GET(direct_resolve_32bpp) || !direct_resolve_32bpp_pipeline_ ||
+      copy_shader != draw_util::ResolveCopyShaderIndex::kFast32bpp1x2xMSAA ||
+      resolve_info.IsCopyingDepth() || edram_info.msaa_samples != xenos::MsaaSamples::k1X ||
+      edram_info.format_is_64bpp ||
+      xenos::ColorRenderTargetFormat(edram_info.format) !=
+          xenos::ColorRenderTargetFormat::k_8_8_8_8) {
+    return nullptr;
+  }
+  uint32_t span_base, span_row_length, span_rows, span_pitch;
+  resolve_info.GetCopyEdramTileSpan(span_base, span_row_length, span_rows, span_pitch);
+  GetResolveCopyRectanglesToDump(span_base, span_row_length, span_rows, span_pitch,
+                                 dump_rectangles_);
+  // One render target owning the whole span, whose origin is the resolve's
+  // base tile: the resolve's EDRAM coordinates are then its pixels.
+  if (dump_rectangles_.size() != 1 || dump_rectangles_[0].row_first ||
+      dump_rectangles_[0].row_first_start) {
+    return nullptr;
+  }
+  auto* render_target = static_cast<D3D12RenderTarget*>(dump_rectangles_[0].render_target);
+  RenderTargetKey key = render_target->key();
+  if (key.is_depth || key.msaa_samples != xenos::MsaaSamples::k1X ||
+      key.GetColorFormat() != xenos::ColorRenderTargetFormat::k_8_8_8_8 ||
+      key.base_tiles != span_base || key.GetPitchTiles() != edram_info.pitch_tiles) {
+    return nullptr;
+  }
+  DXGI_FORMAT format = render_target->resource()->GetDesc().Format;
+  if (format != DXGI_FORMAT_R8G8B8A8_TYPELESS && format != DXGI_FORMAT_R8G8B8A8_UNORM &&
+      format != DXGI_FORMAT_R8G8B8A8_UINT) {
+    return nullptr;
+  }
+  return render_target;
+}
