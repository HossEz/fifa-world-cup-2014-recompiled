+void PipelineCache::InitializePipelineLibrary(const std::filesystem::path& path) {
+  Microsoft::WRL::ComPtr<ID3D12Device1> device;
+  if (FAILED(command_processor_.GetD3D12Provider().GetDevice()->QueryInterface(
+          IID_PPV_ARGS(&device)))) {
+    return;
+  }
+  std::error_code error;
+  std::filesystem::create_directories(path.parent_path(), error);
+  std::lock_guard lock(pipeline_library_mutex_);
+  pipeline_library_path_ = path;
+  pipeline_library_data_.clear();
+  {
+    std::ifstream file(path, std::ios::binary);
+    if (file) {
+      pipeline_library_data_.assign(std::istreambuf_iterator<char>(file),
+                                    std::istreambuf_iterator<char>());
+    }
+  }
+  HRESULT result = E_FAIL;
+  if (!pipeline_library_data_.empty()) {
+    result = device->CreatePipelineLibrary(pipeline_library_data_.data(),
+                                           pipeline_library_data_.size(),
+                                           IID_PPV_ARGS(&pipeline_library_));
+    if (SUCCEEDED(result)) {
+      REXGPU_INFO("Pipeline library: {} KB from {}", pipeline_library_data_.size() >> 10,
+                  rex::path_to_utf8(path));
+    } else {
+      // Another driver or GPU: compiled again, into a new library.
+      REXGPU_INFO("Pipeline library: {} not usable ({:08X}), starting a new one",
+                  rex::path_to_utf8(path), uint32_t(result));
+    }
+  }
+  if (FAILED(result)) {
+    pipeline_library_data_.clear();
+    if (FAILED(device->CreatePipelineLibrary(nullptr, 0, IID_PPV_ARGS(&pipeline_library_)))) {
+      pipeline_library_.Reset();
+      REXGPU_WARN("Pipeline library: not supported, pipelines are compiled at every start");
+    }
+  }
+  pipeline_library_dirty_.store(false, std::memory_order_relaxed);
+  pipeline_library_loaded_.store(0, std::memory_order_relaxed);
+  pipeline_library_compiled_.store(0, std::memory_order_relaxed);
+}
+
+void PipelineCache::SavePipelineLibrary() {
+  std::vector<uint8_t> data;
+  std::filesystem::path path;
+  {
+    std::lock_guard lock(pipeline_library_mutex_);
+    if (!pipeline_library_ || !pipeline_library_dirty_.exchange(false)) {
+      return;
+    }
+    data.resize(pipeline_library_->GetSerializedSize());
+    if (data.empty() || FAILED(pipeline_library_->Serialize(data.data(), data.size()))) {
+      return;
+    }
+    path = pipeline_library_path_;
+  }
+  // Written beside it and then renamed, so the game exiting meanwhile can't
+  // leave a broken library.
+  std::filesystem::path temporary = path;
+  temporary += ".tmp";
+  {
+    std::ofstream file(temporary, std::ios::binary | std::ios::trunc);
+    if (!file.write(reinterpret_cast<const char*>(data.data()), std::streamsize(data.size()))) {
+      return;
+    }
+  }
+  std::error_code error;
+  std::filesystem::rename(temporary, path, error);
+  if (error) {
+    REXGPU_WARN("Pipeline library: couldn't save {}: {}", rex::path_to_utf8(path),
+                error.message());
+  }
+}
