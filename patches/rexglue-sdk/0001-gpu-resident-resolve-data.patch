+void CommandProcessor::MarkGpuMemoryNewer(uint32_t physical_address, uint32_t length,
+                                          bool newer) {
+  if (!length) {
+    return;
+  }
+  physical_address &= 0x1FFFFFFF;
+  uint32_t first = physical_address >> kGpuNewerPageShift;
+  uint32_t last = std::min((physical_address + length - 1) >> kGpuNewerPageShift,
+                           kGpuNewerPageCount - 1);
+  for (uint32_t page = first; page <= last; ++page) {
+    uint64_t bit = uint64_t(1) << (page & 63);
+    if (newer) {
+      gpu_newer_pages_[page >> 6].fetch_or(bit, std::memory_order_relaxed);
+    } else {
+      gpu_newer_pages_[page >> 6].fetch_and(~bit, std::memory_order_relaxed);
+    }
+  }
+}
+
+bool CommandProcessor::IsGpuMemoryNewer(uint32_t physical_address, uint32_t length) const {
+  if (!length) {
+    return false;
+  }
+  physical_address &= 0x1FFFFFFF;
+  uint32_t first = physical_address >> kGpuNewerPageShift;
+  uint32_t last = std::min((physical_address + length - 1) >> kGpuNewerPageShift,
+                           kGpuNewerPageCount - 1);
+  for (uint32_t page = first; page <= last; ++page) {
+    if (gpu_newer_pages_[page >> 6].load(std::memory_order_relaxed) &
+        (uint64_t(1) << (page & 63))) {
+      return true;
+    }
+  }
+  return false;
+}
+
+bool CommandProcessor::QueueGpuMemoryCopy(uint32_t dst_physical, uint32_t src_physical,
+                                          uint32_t length) {
+  if (!SupportsGpuMemoryCopy() || !length) {
+    return false;
+  }
+  dst_physical &= 0x1FFFFFFF;
+  src_physical &= 0x1FFFFFFF;
+  if (dst_physical + length > 0x20000000 || src_physical + length > 0x20000000) {
+    return false;
+  }
+  // Later guest copies out of dst must also take the GPU path, even before the
+  // command processor has run this one.
+  MarkGpuMemoryNewer(dst_physical, length, true);
+  {
+    std::lock_guard lock(gpu_copy_mutex_);
+    gpu_copies_.push_back({dst_physical, src_physical, length});
+    gpu_copies_pending_.store(true, std::memory_order_release);
+  }
+  write_ptr_index_event_->Set();
+  return true;
+}
+
+bool CommandProcessor::ReadbackGpuMemory(uint32_t physical_address, uint32_t length) {
+  if (!SupportsGpuMemoryCopy() || !length) {
+    return false;
+  }
+  physical_address &= 0x1FFFFFFF;
+  length = std::min(length, 0x20000000 - physical_address);
+  std::atomic<bool> done{false};
+  {
+    std::lock_guard lock(gpu_copy_mutex_);
+    gpu_copies_.push_back({physical_address, UINT32_MAX, length, &done});
+    gpu_copies_pending_.store(true, std::memory_order_release);
+  }
+  write_ptr_index_event_->Set();
+  std::unique_lock lock(gpu_copy_mutex_);
+  gpu_copy_done_cv_.wait(lock, [&] { return done.load(std::memory_order_acquire); });
+  return true;
+}
+
+void CommandProcessor::ExecuteQueuedGpuMemoryCopies() {
+  if (!gpu_copies_pending_.load(std::memory_order_acquire)) {
+    return;
+  }
+  std::vector<QueuedGpuMemoryCopy> copies;
+  {
+    std::lock_guard lock(gpu_copy_mutex_);
+    copies.swap(gpu_copies_);
+    gpu_copies_pending_.store(false, std::memory_order_relaxed);
+  }
+  bool any_readback = false;
+  for (const QueuedGpuMemoryCopy& copy : copies) {
+    if (copy.src == UINT32_MAX) {
+      ExecuteGpuMemoryReadback(copy.dst, copy.length);
+      MarkGpuMemoryNewer(copy.dst, copy.length, false);
+      copy.done->store(true, std::memory_order_release);
+      any_readback = true;
+    } else {
+      ExecuteGpuMemoryCopy(copy.dst, copy.src, copy.length);
+    }
+  }
+  if (any_readback) {
+    std::lock_guard lock(gpu_copy_mutex_);
+    gpu_copy_done_cv_.notify_all();
+  }
+}
