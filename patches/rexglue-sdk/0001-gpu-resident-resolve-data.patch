+void D3D12CommandProcessor::ExecuteGpuMemoryCopy(uint32_t dst_physical, uint32_t src_physical,
+                                                 uint32_t length) {
+  if (!BeginSubmission(true)) {
+    return;
+  }
+  // Source holds resolve output; destination pages may be partially covered, so
+  // both must be current in GPU memory before copying (uploads if not).
+  if (!shared_memory_->RequestRange(src_physical, length) ||
+      !shared_memory_->RequestRange(dst_physical, length)) {
+    REXGPU_WARN("GPU memory copy {:08X} -> {:08X} +{:X}: shared memory request failed",
+                src_physical, dst_physical, length);
+    return;
+  }
+  // Source and destination may overlap or share a resource state, so bounce
+  // through a scratch buffer.
+  ID3D12Resource* scratch = RequestScratchGPUBuffer(length, D3D12_RESOURCE_STATE_COPY_DEST);
+  if (!scratch) {
+    return;
+  }
+  shared_memory_->UseAsCopySource();
+  SubmitBarriers();
+  deferred_command_list_.D3DCopyBufferRegion(scratch, 0, shared_memory_->GetBuffer(), src_physical,
+                                             length);
+  PushTransitionBarrier(scratch, D3D12_RESOURCE_STATE_COPY_DEST, D3D12_RESOURCE_STATE_COPY_SOURCE);
+  shared_memory_->UseAsCopyDestination();
+  SubmitBarriers();
+  deferred_command_list_.D3DCopyBufferRegion(shared_memory_->GetBuffer(), dst_physical, scratch, 0,
+                                             length);
+  ReleaseScratchGPUBuffer(scratch, D3D12_RESOURCE_STATE_COPY_SOURCE);
+  // Invalidates textures over dst and keeps the pages valid (GPU-owned).
+  shared_memory_->RangeWrittenByGpu(dst_physical, length);
+  MarkGpuMemoryNewer(dst_physical, length, true);
+}
+
+void D3D12CommandProcessor::ExecuteGpuMemoryReadback(uint32_t physical_address,
+                                                     uint32_t length) {
+  if (!BeginSubmission(true)) {
+    return;
+  }
+  if (!shared_memory_->RequestRange(physical_address, length)) {
+    return;
+  }
+  ID3D12Resource* readback = RequestReadbackBuffer(length);
+  if (!readback) {
+    return;
+  }
+  shared_memory_->UseAsCopySource();
+  SubmitBarriers();
+  deferred_command_list_.D3DCopyBufferRegion(readback, 0, shared_memory_->GetBuffer(),
+                                             physical_address, length);
+  if (!AwaitAllQueueOperationsCompletion()) {
+    return;
+  }
+  D3D12_RANGE read_range = {0, length};
+  void* mapping;
