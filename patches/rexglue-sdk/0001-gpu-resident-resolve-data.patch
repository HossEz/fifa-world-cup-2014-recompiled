+bool D3D12CommandProcessor::IsForcedSyncReadbackAddress(uint32_t address) {
+  // readback_resolve_sync_addresses: comma-separated hex guest addresses whose
+  // resolves adaptive mode always reads back synchronously (per-game tuning).
+  const std::string& list = REXCVAR_GET(readback_resolve_sync_addresses);
+  if (list != forced_sync_readback_source_) {
+    forced_sync_readback_source_ = list;
+    forced_sync_readback_addresses_.clear();
+    std::stringstream stream(list);
+    std::string item;
+    while (std::getline(stream, item, ',')) {
+      try {
+        forced_sync_readback_addresses_.push_back(uint32_t(std::stoul(item, nullptr, 16)));
+      } catch (...) {
+        REXGPU_WARN("readback_resolve_sync_addresses: ignoring '{}'", item);
+      }
+    }
+  }
+  return std::find(forced_sync_readback_addresses_.begin(), forced_sync_readback_addresses_.end(),
+                   address) != forced_sync_readback_addresses_.end();
+}
+
+void D3D12CommandProcessor::FlushQuietReadbackResolves() {
+  // A per-frame resolve stream that stopped (e.g. a multi-frame bake that finished)
+  // still owes guest memory its last result: deliver it once the GPU wrote it.
+  for (auto& [key, rb] : readback_buffers_) {
+    if (!rb.pending_flush || rb.last_used_frame + kReadbackHotGapFrames >= frame_current_) {
+      continue;
+    }
+    rb.pending_flush = false;
+    uint32_t last_index = 1 - rb.current_index;
+    if (!rb.mapped_data[last_index] || rb.guest_length > rb.sizes[last_index]) {
+      continue;
+    }
+    CheckSubmissionFence(rb.submission_written[last_index]);
+    uint8_t* destination = memory_->TranslatePhysical(rb.guest_address);
+    if (destination) {
+      std::memcpy(destination, rb.mapped_data[last_index], rb.guest_length);
+      shared_memory_->RangeWrittenByGpu(rb.guest_address, rb.guest_length);
+    }
+  }
+}
