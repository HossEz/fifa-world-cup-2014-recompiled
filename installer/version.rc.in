// The version resource of the project's programs (Properties, Details in
// Explorer), filled in by installer/version_resource.cmake from VERSION.
#include <winver.h>

VS_VERSION_INFO VERSIONINFO
FILEVERSION @VER_MAJOR@,@VER_MINOR@,@VER_PATCH@,0
PRODUCTVERSION @VER_MAJOR@,@VER_MINOR@,@VER_PATCH@,0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "hosse"
      VALUE "FileDescription", "@FILE_DESCRIPTION@"
      VALUE "FileVersion", "@VERSION_STRING@"
      VALUE "InternalName", "@INTERNAL_NAME@"
      VALUE "LegalCopyright", "Copyright (c) 2026 hosse. Unofficial; not affiliated with EA, FIFA or Microsoft."
      VALUE "OriginalFilename", "@ORIGINAL_FILENAME@"
      VALUE "ProductName", "2014 FIFA World Cup Brazil: Recompiled"
      VALUE "ProductVersion", "@VERSION_STRING@"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
