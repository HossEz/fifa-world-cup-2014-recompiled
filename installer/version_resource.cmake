# add_version_resource(<target> <description> <file name>): gives a Windows
# program the project's version resource (installer/version.rc.in), with the
# version from VERSION. CMake runs again by itself when VERSION changes.

set(VERSION_RESOURCE_DIR ${CMAKE_CURRENT_LIST_DIR})

function(add_version_resource target description file_name)
  if(NOT WIN32)
    return()
  endif()
  set(version_file ${VERSION_RESOURCE_DIR}/../VERSION)
  file(READ ${version_file} VERSION_STRING)
  string(STRIP "${VERSION_STRING}" VERSION_STRING)
  get_property(depends DIRECTORY PROPERTY CMAKE_CONFIGURE_DEPENDS)
  get_filename_component(version_file ${version_file} ABSOLUTE)
  set(listed FALSE)
  foreach(path IN LISTS depends)
    get_filename_component(path ${path} ABSOLUTE)
    if(path STREQUAL version_file)
      set(listed TRUE)
    endif()
  endforeach()
  if(NOT listed)  # once (the launcher's own version code lists it too)
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${version_file})
  endif()
  string(REPLACE "." ";" parts "${VERSION_STRING}")
  list(APPEND parts 0 0 0)
  list(GET parts 0 VER_MAJOR)
  list(GET parts 1 VER_MINOR)
  list(GET parts 2 VER_PATCH)
  set(FILE_DESCRIPTION "${description}")
  set(ORIGINAL_FILENAME "${file_name}")
  get_filename_component(INTERNAL_NAME "${file_name}" NAME_WE)
  set(rc ${CMAKE_CURRENT_BINARY_DIR}/${target}_version.rc)
  configure_file(${VERSION_RESOURCE_DIR}/version.rc.in ${rc} @ONLY)
  target_sources(${target} PRIVATE ${rc})
endfunction()
