{
  "$schema": "https://recomplauncher.com/schema/recomplauncher.json",
  "format": 1,
  "repo": "HossEz/fifa-world-cup-2014-recompiled",
  "inputs": [
    {
      "id": "game",
      "label": "Your copy of 2014 FIFA World Cup Brazil for Xbox 360. Its disc image (.iso), or its folder with default.xex.",
      "formats": [{ "type": "file", "extensions": ["iso"] }, { "type": "folder" }],
      "check": { "file": "default.xex", "xdvdfs": "default.xex" }
    }
  ],
  "start": { "program": ["Launcher.exe"] },
  "saves": ["{install}/saves"],
  "config": [
    {
      "id": "main",
      "format": "toml",
      "file": [{ "path": "{install}/fifawc14.toml" }],
      "game_path": "game_data_root",
      "new": {
        "present_interval_cap": "1",
        "frame_rate_floor": "60",
        "anisotropic_override": "5",
        "log_file": "\"fifawc14.log\"",
        "log_level": "\"info\""
      }
    }
  ],
  "settings": [
    {
      "id": "window", "label": "Window", "group": "Display",
      "help": "Fullscreen fills your screen and lets you switch apps quickly. Exclusive gives the game the screen to itself. Windowed uses Window size.",
      "choices": [
        { "label": "Fullscreen", "set": { "fullscreen": "true", "fullscreen_exclusive": "false" } },
        { "label": "Exclusive", "set": { "fullscreen": "true", "fullscreen_exclusive": "true" } },
        { "label": "Windowed", "set": { "fullscreen": "false" } }
      ],
      "defaults": { "fullscreen": "true", "fullscreen_exclusive": "false" }
    },
    {
      "id": "window_size", "label": "Window size", "group": "Display",
      "help": "The size of the game's window in Windowed mode. Automatic makes it as large as fits your screen. A size larger than your screen is shrunk to fit.",
      "when": { "fullscreen": "false" },
      "choices": [
        { "label": "Automatic", "set": { "windowed_width": "0", "windowed_height": "0" } },
        { "label": "1280 x 720", "set": { "windowed_width": "1280", "windowed_height": "720" } },
        { "label": "1600 x 900", "set": { "windowed_width": "1600", "windowed_height": "900" } },
        { "label": "1920 x 1080", "set": { "windowed_width": "1920", "windowed_height": "1080" } },
        { "label": "2560 x 1440", "set": { "windowed_width": "2560", "windowed_height": "1440" } },
        { "label": "3840 x 2160", "set": { "windowed_width": "3840", "windowed_height": "2160" } }
      ],
      "defaults": { "windowed_width": "0", "windowed_height": "0" }
    },
    {
      "id": "picture", "label": "Picture", "group": "Display",
      "help": "Fit keeps the right shape, with black bars on screens wider than 16:9. Stretch fills the screen, but players and the HUD look wider.",
      "choices": [
        { "label": "Fit", "set": { "present_letterbox": "true" } },
        { "label": "Stretch", "set": { "present_letterbox": "false" } }
      ],
      "defaults": { "present_letterbox": "true" }
    },
    {
      "id": "button_icons", "label": "Button icons", "group": "Display",
      "help": "The controller buttons shown in the game. Automatic matches your controller each time the game starts.",
      "choices": [
        { "label": "Automatic", "set": { "button_icons": "\"auto\"" } },
        { "label": "Xbox", "set": { "button_icons": "\"xbox\"" } },
        { "label": "PlayStation", "set": { "button_icons": "\"playstation\"" } }
      ],
      "defaults": { "button_icons": "\"auto\"" }
    },
    {
      "id": "vsync", "label": "VSync", "group": "Display",
      "help": "On stops tearing and keeps the game at your screen's refresh rate or below. Off lets Frame rate go higher, but can tear.",
      "choices": [
        { "label": "On", "set": { "d3d12_allow_variable_refresh_rate_and_tearing": "false", "vsync_to_display": "true" } },
        { "label": "Off", "set": { "d3d12_allow_variable_refresh_rate_and_tearing": "true", "vsync_to_display": "false" } }
      ],
      "defaults": { "d3d12_allow_variable_refresh_rate_and_tearing": "false", "vsync_to_display": "true" }
    },
    {
      "id": "frame_rate", "label": "Frame rate", "group": "Display",
      "help": "The game holds cutscenes at 40 FPS and many menus at 30, as on the console. These rates lift both limits. Above 60 needs a faster PC.",
      "choices": [
        { "label": "60 FPS", "set": { "present_interval_cap": "1", "frame_rate_floor": "60", "present_late_tolerance": "100" } },
        { "label": "120 FPS", "set": { "present_interval_cap": "1", "frame_rate_floor": "120", "present_late_tolerance": "100" } },
        { "label": "144 FPS", "set": { "present_interval_cap": "1", "frame_rate_floor": "144", "present_late_tolerance": "100" } },
        { "label": "165 FPS", "set": { "present_interval_cap": "1", "frame_rate_floor": "165", "present_late_tolerance": "100" } },
        { "label": "240 FPS", "set": { "present_interval_cap": "1", "frame_rate_floor": "240", "present_late_tolerance": "100" } },
        { "label": "As on console", "set": { "present_interval_cap": "0", "frame_rate_floor": "0", "present_late_tolerance": "0" } }
      ],
      "defaults": { "present_interval_cap": "0", "frame_rate_floor": "0", "present_late_tolerance": "100" }
    },
    {
      "id": "show_fps", "label": "Show FPS", "group": "Display",
      "help": "The frame rate in the top left corner of the game.",
      "choices": [
        { "label": "Off", "set": { "show_fps": "false" } },
        { "label": "On", "set": { "show_fps": "true" } }
      ],
      "defaults": { "show_fps": "false" }
    },
    {
      "id": "resolution", "label": "Render resolution", "group": "Graphics",
      "help": "What the game draws at, then fits to your screen. 720p is the console's own. 1440p is sharp on a 1080p screen. 4K needs a fast graphics card.",
      "choices": [
        { "label": "720p", "set": { "resolution_scale": "1" } },
        { "label": "1440p", "set": { "resolution_scale": "2" } },
        { "label": "4K", "set": { "resolution_scale": "3" } }
      ],
      "defaults": { "resolution_scale": "1" }
    },
    {
      "id": "upscaling", "label": "Upscaling", "group": "Graphics",
      "help": "FSR sharpens the picture as it's fitted to your screen, most of all at 720p on a 1080p screen. It can look a bit artificial.",
      "choices": [
        { "label": "Off", "set": { "present_effect": "\"bilinear\"" } },
        { "label": "FSR", "set": { "present_effect": "\"fsr\"" } }
      ],
      "defaults": { "present_effect": "\"bilinear\"" }
    },
    {
      "id": "filtering", "label": "Texture filtering", "group": "Graphics",
      "help": "Keeps the pitch markings and the stands sharp at shallow angles. Costs next to nothing on today's graphics cards.",
      "choices": [
        { "label": "Game's own", "set": { "anisotropic_override": "-1" } },
        { "label": "2x", "set": { "anisotropic_override": "2" } },
        { "label": "4x", "set": { "anisotropic_override": "3" } },
        { "label": "8x", "set": { "anisotropic_override": "4" } },
        { "label": "16x", "set": { "anisotropic_override": "5" } }
      ],
      "defaults": { "anisotropic_override": "3" }
    }
  ]
}
